{
  "name": "@c5h-soft/discord-logger",
  "version": "1.0.0",
  "description": "Lightweight Discord webhook logger with pino integration, colored output, and timezone support",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "discord",
    "logger",
    "webhook",
    "pino",
    "logging",
    "notifications"
  ],
  "author": "c5h.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c5h-soft/discord-logger.git"
  },
  "homepage": "https://github.com/c5h-soft/discord-logger#readme",
  "bugs": {
    "url": "https://github.com/c5h-soft/discord-logger/issues"
  },
  "dependencies": {
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
